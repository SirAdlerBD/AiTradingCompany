# Copy to /etc/desk/desk.env, chmod 640, root:desk.
# SIM only. There is deliberately no LIVE variable; the guard aborts if any
# SAXO_* variable containing "LIVE" is present in the process environment.

# The MCP_ACCESS_TOKEN of the saxo-mcp HTTP server (its .env), SIM instance.
SAXO_SIM_MCP_TOKEN=
# Comma-separated Saxo SIM AccountKey values. Get them from get_account_summary
# (accounts[].AccountKey). Every account the server reports must be listed.
SAXO_SIM_ACCOUNT_KEYS=
# Only read when fmp_mcp.enabled is true in desk.yaml.
FMP_API_KEY=
